    "lenis": "^1.3.25",
    "lucide-react": "^0.400.0",
    "minimatch": "11.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "sonner": "^2.0.7",
    "source-map-js": "1.2.2",
    "systeminformation": "^5.33.16",
    "tailwind-merge": "^3.0.0",
    "tar": "7.5.22",
    "zod": "^4.6.6"
