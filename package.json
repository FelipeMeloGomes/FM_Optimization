    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^3.0.0",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.4",
    "vitest": "^4.1.11"
