{
  "name": "fm-optimize",
  "version": "2.22.0",
  "description": "FM Optimize - Windows optimization toolkit",
  "author": "Felipe Melo Gomes",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev -- --js-flags=\"--max-old-space-size=192 --expose-gc\"",
    "start": "electron . --js-flags=\"--max-old-space-size=192\"",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "systeminformation": "^5.33.23",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-virtual": "^3.14.26",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/mocker": "5.1.1",
    "@xmldom/xmldom": "0.9.12",
    "app-builder-lib": "26.18.0",
    "baseline-browser-mapping": "2.11.39",
    "brace-expansion": "5.0.13",
    "builder-util-runtime": "9.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "js-yaml": "5.5.0",
    "jsdom": "^31.0.1",
    "lucide-react": "^1.77.0",
    "minimatch": "11.0.9",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "rollup-plugin-visualizer": "^7.1.3",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "source-map-js": "1.2.4",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tar": "7.5.23",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "minimatch": "11.0.9",
    "brace-expansion": "5.0.13",
    "@xmldom/xmldom": "0.9.12"
  }
}
